   "metadata": {},
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 📊 Exploración de Datos - Data Warehouse España\\n\",\n",
    "    \"\\n\",\n",
    "    \"Este notebook proporciona análisis exploratorio de los datos almacenados en el Data Warehouse.\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Datasets disponibles:**\\n\",\n",
    "    \"- `fact_despoblamiento`: Indicadores de despoblamiento por provincia\\n\",\n",
    "    \"- `fact_poblacion`: Población por municipio y sexo (1996-2023)\\n\",\n",
    "    \"- `fact_industria`: Datos industriales por provincia\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Configuración inicial\\n\",\n",
    "    \"import duckdb\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Configuración de visualización\\n\",\n",
    "    \"plt.style.use('seaborn-v0_8-whitegrid')\\n\",\n",
    "    \"pd.set_option('display.max_columns', None)\\n\",\n",
    "    \"pd.set_option('display.max_rows', 100)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Conexión al warehouse\\n\",\n",
    "    \"DB_PATH = Path('../data/warehouse.duckdb')\\n\",\n",
    "    \"conn = duckdb.connect(str(DB_PATH), read_only=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"✅ Conectado al Data Warehouse\\\")\\n\",\n",
    "    \"print(\\\"\\\\n📋 Tablas disponibles:\\\")\\n\",\n",
    "    \"conn.execute(\\\"SHOW TABLES\\\").fetchdf()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Exploración Inicial\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Información de cada tabla\\n\",\n",
    "    \"tables = ['fact_despoblamiento', 'fact_poblacion', 'fact_industria']\\n\",\n",
    "    \"\\n\",\n",
    "    \"for table in tables:\\n\",\n",
    "    \"    count = conn.execute(f\\\"SELECT COUNT(*) FROM {table}\\\").fetchone()[0]\\n\",\n",
    "    \"    print(f\\\"\\\\n📊 {table}: {count:,} filas\\\")\\n\",\n",
    "    \"    display(conn.execute(f\\\"DESCRIBE {table}\\\").fetchdf())\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Análisis de Despoblamiento\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Cargar datos de despoblamiento\\n\",\n",
    "    \"df_desp = conn.execute(\\\"\\\"\\\"\\n\",\n",
    "    \"    SELECT \\n\",\n",
    "    \"        porcentaje_despoblamiento,\\n\",\n",
    "    \"        poblacion_total,\\n\",\n",
    "    \"        poblacion_hombres,\\n\",\n",
    "    \"        poblacion_mujeres,\\n\",\n",
    "    \"        tasa_actividad_total,\\n\",\n",
    "    \"        tasa_empleo_total,\\n\",\n",
    "    \"        tasa_paro_total,\\n\",\n",
    "    \"        pib_precios_corrientes,\\n\",\n",
    "    \"        categoria_despoblamiento\\n\",\n",
    "    \"    FROM fact_despoblamiento\\n\",\n",
    "    \"    WHERE porcentaje_despoblamiento IS NOT NULL\\n\",\n",
    "    \"\\\"\\\"\\\").fetchdf()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Registros: {len(df_desp)}\\\")\\n\",\n",
    "    \"df_desp.describe()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Visualización: Distribución de despoblamiento\\n\",\n",
    "    \"fig, axes = plt.subplots(2, 2, figsize=(14, 10))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Histograma de despoblamiento\\n\",\n",
    "    \"axes[0, 0].hist(df_desp['porcentaje_despoblamiento'], bins=20, edgecolor='black', alpha=0.7)\\n\",\n",
    "    \"axes[0, 0].set_xlabel('Porcentaje de Despoblamiento')\\n\",\n",
    "    \"axes[0, 0].set_ylabel('Frecuencia')\\n\",\n",
    "    \"axes[0, 0].set_title('Distribución del Despoblamiento')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Boxplot por categoría\\n\",\n",
    "    \"df_desp.boxplot(column='tasa_paro_total', by='categoria_despoblamiento', ax=axes[0, 1])\\n\",\n",
    "    \"axes[0, 1].set_title('Tasa de Paro por Categoría de Despoblamiento')\\n\",\n",
    "    \"axes[0, 1].set_xlabel('Categoría')\\n\",\n",
    "    \"axes[0, 1].set_ylabel('Tasa de Paro (%)')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Scatter: Despoblamiento vs PIB\\n\",\n",
    "    \"axes[1, 0].scatter(df_desp['porcentaje_despoblamiento'], \\n\",\n",
    "    \"                   df_desp['pib_precios_corrientes']/1e9, \\n\",\n",
    "    \"                   alpha=0.6)\\n\",\n",
    "    \"axes[1, 0].set_xlabel('Porcentaje de Despoblamiento')\\n\",\n",
    "    \"axes[1, 0].set_ylabel('PIB (miles de millones €)')\\n\",\n",
    "    \"axes[1, 0].set_title('Despoblamiento vs PIB')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Scatter: Tasa de empleo vs Tasa de paro\\n\",\n",
    "    \"scatter = axes[1, 1].scatter(df_desp['tasa_empleo_total'], \\n\",\n",
    "    \"                             df_desp['tasa_paro_total'],\\n\",\n",
    "    \"                             c=df_desp['porcentaje_despoblamiento'],\\n\",\n",
    "    \"                             cmap='RdYlGn_r', alpha=0.7)\\n\",\n",
    "    \"axes[1, 1].set_xlabel('Tasa de Empleo (%)')\\n\",\n",
    "    \"axes[1, 1].set_ylabel('Tasa de Paro (%)')\\n\",\n",
    "    \"axes[1, 1].set_title('Empleo vs Paro (color = despoblamiento)')\\n\",\n",
    "    \"plt.colorbar(scatter, ax=axes[1, 1], label='% Despoblamiento')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('../data/despoblamiento_analysis.png', dpi=150)\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Análisis de Población\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Evolución de población total por año\\n\",\n",
    "    \"df_evolucion = conn.execute(\\\"\\\"\\\"\\n\",\n",
    "    \"    SELECT \\n\",\n",
    "    \"        periodo as año,\\n\",\n",
    "    \"        SUM(total) as poblacion_total\\n\",\n",
    "    \"    FROM fact_poblacion\\n\",\n",
    "    \"    WHERE sexo = 'Total' AND periodo >= 1998\\n\",\n",
    "    \"    GROUP BY periodo\\n\",\n",
    "    \"    ORDER BY periodo\\n\",\n",
    "    \"\\\"\\\"\\\").fetchdf()\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.figure(figsize=(12, 6))\\n\",\n",
    "    \"plt.plot(df_evolucion['año'], df_evolucion['poblacion_total']/1e6, marker='o', linewidth=2)\\n\",\n",
    "    \"plt.xlabel('Año')\\n\",\n",
    "    \"plt.ylabel('Población (millones)')\\n\",\n",
    "    \"plt.title('Evolución de la Población de España')\\n\",\n",
    "    \"plt.grid(True, alpha=0.3)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('../data/poblacion_evolucion.png', dpi=150)\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Top 10 provincias por población\\n\",\n",
    "    \"df_provincias = conn.execute(\\\"\\\"\\\"\\n\",\n",
    "    \"    SELECT \\n\",\n",
    "    \"        nombre_provincia,\\n\",\n",
    "    \"        SUM(total) as poblacion\\n\",\n",
    "    \"    FROM fact_poblacion\\n\",\n",
    "    \"    WHERE sexo = 'Total' AND periodo = 2023\\n\",\n",
    "    \"    GROUP BY nombre_provincia\\n\",\n",
    "    \"    ORDER BY poblacion DESC\\n\",\n",
    "    \"    LIMIT 15\\n\",\n",
    "    \"\\\"\\\"\\\").fetchdf()\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.figure(figsize=(12, 8))\\n\",\n",
    "    \"plt.barh(df_provincias['nombre_provincia'][::-1], df_provincias['poblacion'][::-1]/1e6)\\n\",\n",
    "    \"plt.xlabel('Población (millones)')\\n\",\n",
    "    \"plt.title('Top 15 Provincias por Población (2023)')\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('../data/top_provincias.png', dpi=150)\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Distribución por sexo\\n\",\n",
    "    \"df_sexo = conn.execute(\\\"\\\"\\\"\\n\",\n",
    "    \"    SELECT \\n\",\n",
    "    \"        sexo,\\n\",\n",
    "    \"        SUM(total) as poblacion\\n\",\n",
    "    \"    FROM fact_poblacion\\n\",\n",
    "    \"    WHERE sexo != 'Total' AND periodo = 2023\\n\",\n",
    "    \"    GROUP BY sexo\\n\",\n",
    "    \"\\\"\\\"\\\").fetchdf()\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.figure(figsize=(8, 8))\\n\",\n",
    "    \"plt.pie(df_sexo['poblacion'], labels=df_sexo['sexo'], autopct='%1.1f%%', \\n\",\n",
    "    \"        colors=['#3498db', '#e74c3c'], startangle=90)\\n\",\n",
    "    \"plt.title('Distribución de Población por Sexo (2023)')\\n\",\n",
    "    \"plt.savefig('../data/distribucion_sexo.png', dpi=150)\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Análisis de Industria\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# PIB industrial por provincia\\n\",\n",
    "    \"df_industria = conn.execute(\\\"\\\"\\\"\\n\",\n",
    "    \"    SELECT \\n\",\n",
    "    \"        provincia,\\n\",\n",
    "    \"        SUM(pib_municipios_2016) as pib_total,\\n\",\n",
    "    \"        COUNT(DISTINCT municipio) as num_municipios,\\n\",\n",
    "    \"        SUM(afiliados_diciembre_de_2016) as afiliados\\n\",\n",
    "    \"    FROM fact_industria\\n\",\n",
    "    \"    WHERE pib_municipios_2016 IS NOT NULL\\n\",\n",
    "    \"    GROUP BY provincia\\n\",\n",
    "    \"    ORDER BY pib_total DESC\\n\",\n",
    "    \"\\\"\\\"\\\").fetchdf()\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_industria.head(10)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Top sectores por valor añadido\\n\",\n",
    "    \"df_sectores = conn.execute(\\\"\\\"\\\"\\n\",\n",
    "    \"    SELECT \\n\",\n",
    "    \"        aaee_seccin_cnae09 as sector,\\n\",\n",
    "    \"        SUM(vab_corregido_2016) as valor_añadido,\\n\",\n",
    "    \"        SUM(afiliados_diciembre_de_2016) as afiliados\\n\",\n",
    "    \"    FROM fact_industria\\n\",\n",
    "    \"    WHERE aaee_seccin_cnae09 IS NOT NULL AND vab_corregido_2016 IS NOT NULL\\n\",\n",
    "    \"    GROUP BY sector\\n\",\n",
    "    \"    ORDER BY valor_añadido DESC\\n\",\n",
    "    \"    LIMIT 10\\n\",\n",
    "    \"\\\"\\\"\\\").fetchdf()\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(16, 6))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Valor añadido\\n\",\n",
    "    \"axes[0].barh(df_sectores['sector'][::-1], df_sectores['valor_añadido'][::-1]/1e9)\\n\",\n",
    "    \"axes[0].set_xlabel('Valor Añadido Bruto (miles de millones €)')\\n\",\n",
    "    \"axes[0].set_title('Top 10 Sectores por VAB')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Afiliados\\n\",\n",
    "    \"axes[1].barh(df_sectores['sector'][::-1], df_sectores['afiliados'][::-1]/1e6)\\n\",\n",
    "    \"axes[1].set_xlabel('Afiliados (millones)')\\n\",\n",
    "    \"axes[1].set_title('Top 10 Sectores por Afiliados')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('../data/sectores_industria.png', dpi=150)\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 5. Consultas SQL Personalizadas\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Función para ejecutar consultas personalizadas\\n\",\n",
    "    \"def query(sql):\\n\",\n",
    "    \"    \\\"\\\"\\\"Ejecuta una consulta SQL y retorna un DataFrame.\\\"\\\"\\\"\\n\",\n",
    "    \"    return conn.execute(sql).fetchdf()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Ejemplo: Escribe tu propia consulta\\n\",\n",
    "    \"mi_consulta = \\\"\\\"\\\"\\n\",\n",
    "    \"SELECT \\n\",\n",
    "    \"    nombre_provincia,\\n\",\n",
    "    \"    COUNT(DISTINCT nombre_municipio) as num_municipios,\\n\",\n",
    "    \"    SUM(total) as poblacion_total\\n\",\n",
    "    \"FROM fact_poblacion\\n\",\n",
    "    \"WHERE sexo = 'Total' AND periodo = 2023\\n\",\n",
    "    \"GROUP BY nombre_provincia\\n\",\n",
    "    \"ORDER BY poblacion_total DESC\\n\",\n",
    "    \"LIMIT 10\\n\",\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"query(mi_consulta)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 6. Exportar Resultados\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Exportar resumen a Excel\\n\",\n",
    "    \"with pd.ExcelWriter('../data/resumen_analisis.xlsx') as writer:\\n\",\n",
    "    \"    df_evolucion.to_excel(writer, sheet_name='Evolucion_Poblacion', index=False)\\n\",\n",
    "    \"    df_provincias.to_excel(writer, sheet_name='Top_Provincias', index=False)\\n\",\n",
    "    \"    df_industria.to_excel(writer, sheet_name='Industria_Provincia', index=False)\\n\",\n",
    "    \"    df_sectores.to_excel(writer, sheet_name='Top_Sectores', index=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"✅ Resumen exportado a 'data/resumen_analisis.xlsx'\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Cerrar conexión\\n\",\n",
    "    \"conn.close()\\n\",\n",
    "    \"print(\\\"✅ Análisis completado\\\")\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
