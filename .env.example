# Variables de entorno para el pipeline de Data Engineering
# Copiar este archivo como .env y configurar las variables

# ============================================
# Configuración de Airflow
# ============================================
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:///./airflow/airflow.db
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW_UID=50000

# ============================================
# Configuración de Base de Datos Local (DuckDB)
# ============================================
LOCAL_DB_PATH=./data/warehouse.duckdb

# ============================================
# Configuración de Snowflake (Producción)
# ============================================
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=SPAIN_DATA
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN

# ============================================
# Configuración de GROQ (LLM - GRATIS)
# Obtener tu clave en: https://console.groq.com/
# ============================================
GROQ_API_KEY=gsk_your_groq_api_key_here

# ============================================
# Configuración de Tavily (Búsqueda Web - nivel GRATIS)
# Obtener tu clave en: https://tavily.com/
# ============================================
TAVILY_API_KEY=tvly_your_tavily_api_key_here

# ============================================
# Proveedores de LLM Alternativos (Opcional)
# ============================================
# OPENAI_API_KEY=sk-your_openai_key
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key

# ============================================
# Configuración de Google Cloud Platform (Opcional)
# ============================================
GCP_PROJECT_ID=your-gcp-project
GCP_BUCKET_NAME=your-data-bucket
GCP_VERTEX_DATASTORE_ID=your-datastore-id
GOOGLE_APPLICATION_CREDENTIALS=./credentials/gcp-service-account.json

# ============================================
# Configuración de Azure (Opcional)
# ============================================
AZURE_STORAGE_CONNECTION_STRING=your_connection_string
AZURE_CONTAINER_NAME=data-pipeline

# ============================================
# Configuración del Pipeline
# ============================================
LOG_LEVEL=INFO
BATCH_SIZE=10000
DATA_SOURCE_PATH=./raw_data
OUTPUT_PATH=./data/processed

